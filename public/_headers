# Cloudflare Pages response headers (copied to the build root from public/).
# Every rule matching a path applies; the same header in two rules is joined
# with a comma, so each header is set by one rule only. Pages Functions
# (/proxy) do not get these: functions/proxy.ts sets its own.

# Cross-origin isolation on the whole site: Path of Building under /pob and
# /web-pob needs crossOriginIsolated (SharedArrayBuffer, threads).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# Every PoB build sits in a folder of its own, <ref>-<id> with <id> from the
# hash of its files (tools/export-site.ps1): a changed build gets a new
# address, so a folder is cached for good and this rule never changes.
# pob-app/index.html and pob-app/versions.json are not inside a folder and keep the
# short default cache, so visitors move to a new build at once.
/pob-app/:build/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400
